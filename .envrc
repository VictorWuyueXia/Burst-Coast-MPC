#!/usr/bin/env bash
# direnv: auto-activate the project's conda environment when you enter this directory.
# Usage:
#   1) Install direnv: `brew install direnv`
#   2) Enable for zsh:  `echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc` then restart terminal
#   3) Allow this file once: `direnv allow`
if command -v conda >/dev/null 2>&1; then
  # Load conda shell functions into the current shell session.
  # conda.sh lives under the conda "base" directory.
  # shellcheck disable=SC1090
  source "$(conda info --base)/etc/profile.d/conda.sh"
  # Activate the project conda environment.
  conda activate burst-coast-mpc
else
  echo "conda not found"
fi
