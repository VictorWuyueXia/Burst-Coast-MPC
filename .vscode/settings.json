{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.profiles.windows": {
    "PowerShell (burst-coast-mpc)": {
      "source": "PowerShell",
      "args": [
        "-NoExit",
        "-Command",
        "if (Get-Command conda -ErrorAction SilentlyContinue) { conda activate burst-coast-mpc }; Set-Location -Path '${workspaceFolder}'"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell (burst-coast-mpc)",
  "terminal.integrated.profiles.linux": {
    "bash (.venv)": {
      "path": "/bin/bash",
      "args": [
        "-c",
        "source \"${workspaceFolder}/.venv/bin/activate\" && exec bash -i"
      ]
    }
  },
  "terminal.integrated.defaultProfile.linux": "bash (.venv)",
  "terminal.integrated.env.linux": {
    "VIRTUAL_ENV": "${workspaceFolder}/.venv",
    "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
  }
}
